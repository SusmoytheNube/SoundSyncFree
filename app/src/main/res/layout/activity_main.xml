<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:id="@+id/title" android:text="SoundSync Free" android:textSize="28sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/status" android:text="Ready" android:paddingTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/select" android:text="Select local song" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/startHost" android:text="Start host / stream" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <Button android:id="@+id/stopHost" android:text="Stop host" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:text="Nearby hosts" android:textSize="20sp" android:textStyle="bold" android:paddingTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <ListView android:id="@+id/hosts" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <Button android:id="@+id/youtube" android:text="YouTube" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
